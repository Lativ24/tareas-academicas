    {
      "parameters": {
        "jsCode": "const VENTANA_DIAS = 2;\nconst IDS_INVALIDOS = new Set(['', '123456789', 'undefined', 'null']);\nconst filas = $input.all().map((item) => item.json);\nconst hoy = $now.startOf('day');\n\nconst esc = (valor) => String(valor ?? '')\n  .replaceAll('&', '&amp;')\n  .replaceAll('<', '&lt;')\n  .replaceAll('>', '&gt;');\n\nconst porUsuario = new Map();\n\nfor (const fila of filas) {\n  if (String(fila.Estado).toLowerCase() !== 'pendiente' || !fila.Fecha) continue;\n\n  const usuario = String(fila.Usuario ?? '').trim();\n  const chatIdValido = /^-?\\d+$/.test(usuario) && !IDS_INVALIDOS.has(usuario);\n  if (!chatIdValido) continue;\n\n  const fecha = DateTime.fromFormat(String(fila.Fecha).trim(), 'yyyy-MM-dd', {\n    zone: hoy.zoneName,\n  });\n  if (!fecha.isValid) continue;\n\n  const diasRestantes = Math.round(fecha.startOf('day').diff(hoy, 'days').days);\n  if (diasRestantes > VENTANA_DIAS) continue;\n  if (String(fila.RecordatorioEnviado) === 'Si' && diasRestantes > 0) continue;\n\n  let etiqueta;\n  if (diasRestantes < 0) etiqueta = `VENCIDA hace ${Math.abs(diasRestantes)} dia(s)`;\n  else if (diasRestantes === 0) etiqueta = 'VENCE HOY';\n  else if (diasRestantes === 1) etiqueta = 'vence manana';\n  else etiqueta = `faltan ${diasRestantes} dias`;\n\n  if (!porUsuario.has(usuario)) porUsuario.set(usuario, []);\n  porUsuario.get(usuario).push({ ...fila, diasRestantes, etiqueta });\n}\n\nconst salida = [];\nfor (const [usuario, tareas] of porUsuario) {\n  tareas.sort((a, b) => a.diasRestantes - b.diasRestantes);\n  const lineas = tareas.map((tarea) =>\n    `<b>${esc(tarea.Materia)}</b>  [${esc(tarea.Prioridad)}]\\n` +\n    `   ${esc(tarea.Tarea)}\\n` +\n    `   Entrega: ${esc(tarea.Fecha)} ${esc(tarea.Hora)} - <i>${esc(tarea.etiqueta)}</i>\\n` +\n    `   ID: <code>${esc(tarea.ID)}</code>`\n  );\n\n  salida.push({\n    json: {\n      chatId: usuario,\n      cantidad: tareas.length,\n      ids: tareas.map((tarea) => tarea.ID),\n      texto: `<b>RECORDATORIO</b>\\n\\nTienes ${tareas.length} tarea(s) que requieren atencion:\\n\\n${lineas.join('\\n\\n')}`,\n    },\n  });\n}\n\nreturn salida;"
      },
